---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Nie odnaleziono strony | hellokostek" noindex={true}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-16">
    <span class="font-mono text-xs uppercase tracking-widest text-[#E0115F] font-bold mb-3">
      Błąd 404 • Nie odnaleziono strony
    </span>
    <h1 class="font-display text-4xl sm:text-6xl text-gray-950 font-normal mb-4">
      Pusta sztaluga
    </h1>
    <p class="text-gray-600 max-w-md text-base leading-relaxed mb-8">
      Strona, której szukasz, mogła zostać przeniesiona lub jej adres URL uległ zmianie.
    </p>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-md mx-auto sm:max-w-none">
      <a 
        href="/sklep" 
        class="button w-full sm:w-auto text-center cursor-pointer"
      >
        <div class="button__blobs">
          <div></div>
          <div></div>
          <div></div>
        </div>
        <div class="button__text font-bold">
          Zobacz sklep
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </div>
      </a>
      <a 
        href="/" 
        class="button button--secondary w-full sm:w-auto text-center cursor-pointer"
      >
        <div class="button__blobs">
          <div></div>
          <div></div>
          <div></div>
        </div>
        <div class="button__text font-bold">
          Strona główna
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </div>
      </a>
    </div>
  </div>
</Layout>
