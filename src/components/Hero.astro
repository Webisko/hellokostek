---
import heroObraz from '../assets/portret_franka.webp';
---

<section class="pt-12 md:pt-20 lg:pt-16 xl:pt-12 2xl:pt-20 pb-12 md:pb-20 lg:pb-16 xl:pb-14 2xl:pb-24 bg-white text-gray-900">
  <div class="content-container grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-12 xl:gap-20 items-center">
    <!-- Left: Massive Serif text + CTA -->
    <div class="lg:col-span-7 2xl:col-span-6 space-y-8 font-sans text-center lg:text-left flex flex-col items-center lg:items-start">
      <div class="block">
        <span class="font-mono text-[10px] sm:text-xs tracking-wider sm:tracking-widest uppercase text-gray-400 font-bold block">
          PRACOWNIA ARTYSTYCZNA • KOSTEK MACIEJ KOSTECZKA
        </span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-[80px] xl:text-[110px] 2xl:text-[120px] leading-[0.95] tracking-tighter text-gray-950 font-normal">
        Człowiek dla człowieka – <span class="text-[#E0115F]">sztuka prawdziwa</span> bez AI
      </h1>
      <p class="font-sans text-gray-700 text-lg leading-relaxed max-w-xl font-normal mx-auto lg:mx-0">
        Malarstwo olejne
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4 w-full">
        <a
          href="#kontakt-sekcja"
          class="button text-center"
        >
          <div class="button__blobs">
            <div></div>
            <div></div>
            <div></div>
          </div>
          <div class="button__text font-bold">
            Zamów swój portret
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </div>
        </a>
      </div>
    </div>
    <!-- Right: Premium oil portrait presentation -->
    <div class="lg:col-span-5 2xl:col-span-6 flex flex-col justify-center">
      <div class="relative w-full aspect-square overflow-hidden rounded-[32px] border border-gray-100 shadow-sm bg-gray-55">
        <picture>
          <source media="(max-width: 639px)" srcset="/images/portret_franka_mobile.webp" type="image/webp" />
          <img
            src={heroObraz.src}
            alt="Portret olejny namalowany ze zdjęcia"
            referrerpolicy="no-referrer"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={600}
            height={600}
            class="w-full h-full aspect-square object-cover block"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
