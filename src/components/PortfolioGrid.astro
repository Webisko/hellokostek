---
import portretLeona from "../assets/portret_Leona.webp";
import portretMarysi from "../assets/portret_Marysi.webp";
import portretOliwii from "../assets/portret_Oliwii.webp";
import portretSlubnyPary from "../assets/portret_slubny_pary.webp";

const portfolioItems = [
  {
    src: portretLeona.src,
    alt: "Portret kobiety",
    format: "Płótno prostokątne • 30×40 cm",
    isOval: false
  },
  {
    src: portretOliwii.src,
    alt: "Portret psa Tequili",
    format: "Płótno owalne • 30×40 cm",
    isOval: true
  },
  {
    src: portretSlubnyPary.src,
    alt: "Portret trzech dziewczynek",
    format: "Płótno prostokątne • 40×50 cm",
    isOval: false
  },
  {
    src: portretMarysi.src,
    alt: "Portret śpiącego niemowlęcia",
    format: "Płótno prostokątne • 30×40 cm",
    isOval: false
  }
];
---

<section class="bg-white border-y border-gray-100 py-20 md:py-28 lg:py-24 xl:py-20 2xl:py-32">
  <div class="content-container space-y-16">
    <header class="space-y-3 max-w-2xl mx-auto text-center">
      <span class="font-mono text-xs text-[#E0115F] uppercase tracking-widest block font-bold">PORTFOLIO</span>
      <h2 class="font-display text-4xl sm:text-5xl text-gray-950 font-normal">
        Portrety z mojej pracowni
      </h2>
      <p class="font-sans text-gray-600 text-base leading-relaxed max-w-[480px] mx-auto">
        Dotychczasowe zamówienia.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
      {portfolioItems.map((item) => (
        <div class="space-y-6 group">
          <div 
            class={`aspect-[3/4] overflow-hidden bg-gray-100 border border-gray-100 relative ${item.isOval ? "rounded-[50%]" : "rounded-[24px]"}`}
            style={item.isOval ? "border-radius: 50%" : ""}
          >
            <img
              src={item.src}
              alt={item.alt}
              referrerpolicy="no-referrer"
              loading="lazy"
              decoding="async"
              width={600}
              height={800}
              class="w-full h-full object-cover transition-all duration-700 ease-out group-hover:scale-105"
            />
          </div>
          <div class="text-center pt-2">
            <span class="font-mono text-sm sm:text-base text-gray-500 block">{item.format}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Action buttons under the grid -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 pt-12 md:pt-16 w-full max-w-md mx-auto sm:max-w-none">
      <a
        href="#kontakt-sekcja"
        class="button w-full sm:w-auto text-center cursor-pointer"
      >
        <div class="button__blobs">
          <div></div>
          <div></div>
          <div></div>
        </div>
        <div class="button__text font-bold">
          Zamów swój portret
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </div>
      </a>
      <a
        href="/galeria"
        class="button button--secondary w-full sm:w-auto text-center cursor-pointer"
      >
        <div class="button__blobs">
          <div></div>
          <div></div>
          <div></div>
        </div>
        <div class="button__text font-bold">
          Zobacz galerię portretów
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-1.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </div>
      </a>
    </div>
  </div>
</section>
