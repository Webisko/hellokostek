APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Security: MUST be false on production
APP_DEBUG=true
APP_URL=http://localhost
APP_INDEXABLE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Security: change to 'warning' or 'error' on production to avoid leaking stack traces in logs
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Security: set to true on production (can be false locally for easier debugging)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Security: set to true when serving over HTTPS (always true on production)
SESSION_SECURE_COOKIE=true
# Security: strict prevents CSRF via cross-site form submissions
SESSION_SAME_SITE=strict

# Security: Path for the Filament administration panel (obscurity)
FILAMENT_PATH=admin
# Security: Expiration time for Sanctum storefront personal access tokens in minutes (7 days = 10080)
SANCTUM_TOKEN_EXPIRATION=10080
# Security: Allowed origins for API requests (comma-separated CORS domains)
ALLOWED_ORIGINS=http://localhost:3000
# Security: Expiration time for password reset tokens in minutes
AUTH_PASSWORD_RESET_EXPIRE=15
# Security: Timeout for password confirmation prompts in seconds (1 hour = 3600)
AUTH_PASSWORD_TIMEOUT=3600
# Security: URL of the frontend storefront application (used for redirects like email verification)
FRONTEND_URL=http://localhost:3000
# Storefront URL used for payment redirects (Stripe/Przelewy24 return URL)
STOREFRONT_URL=http://localhost:3000
# Security: Add security headers at the PHP middleware level (disable if handled by Nginx/Cloudflare)
ADD_SECURITY_HEADERS=true
# Security: Content Security Policy default configuration
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; img-src 'self' data: https:; font-src 'self' data: https://fonts.bunny.net; connect-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none';"
# Security: Cross-Origin Opener Policy (COOP) and Cross-Origin Resource Policy (CORP)
COOP_HEADER=same-origin
CORP_HEADER=same-origin

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# On dev/staging set this to the admin inbox so test and preview emails never reach customers.
MAIL_REDIRECT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PRZELEWY24_ENABLED=true
PRZELEWY24_MERCHANT_ID=
PRZELEWY24_POS_ID=
PRZELEWY24_CRC=
PRZELEWY24_API_KEY=
PRZELEWY24_API_BASE_URL=https://sandbox.przelewy24.pl/api/v1
# Optional override; when empty the redirect URL is derived from PRZELEWY24_API_BASE_URL.
PRZELEWY24_REDIRECT_BASE_URL=
PRZELEWY24_CALLBACK_TOKEN=

STRIPE_ENABLED=true
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Enable only where first-party analytics should actually be collected.
ANALYTICS_ENABLED=false
# Comma-separated list of accepted payload environments, e.g. production or staging,production.
ANALYTICS_ACCEPTED_ENVIRONMENTS=production

GOOGLE_PLACES_API_KEY=
# Optional: set this once the exact listing id is known to skip the text search lookup.
GOOGLE_PLACES_PLACE_ID=
GOOGLE_PLACES_BUSINESS_NAME="Generic Shop"
GOOGLE_PLACES_CACHE_TTL_MINUTES=180
GOOGLE_PLACES_LANGUAGE=pl

# Abandoned Cart recovery options
ABANDONED_CART_ENABLED=true
ABANDONED_CART_HOURS_THRESHOLD=2

# Analytics and SEO
TRACK_REDIRECT_HITS=true

# Logistics: InPost ShipX configuration
INPOST_ORGANIZATION_ID=
INPOST_TOKEN=
INPOST_SANDBOX=true
INPOST_SENDER_EMAIL=
INPOST_SENDER_PHONE=
INPOST_SENDER_NAME=
INPOST_SENDER_COMPANY=
INPOST_SENDER_STREET=
INPOST_SENDER_BUILDING=
INPOST_SENDER_CITY=
INPOST_SENDER_POSTCODE=

# Logistics: ORLEN Paczka configuration
ORLEN_PACZKA_PARTNER_ID=
ORLEN_PACZKA_PARTNER_KEY=
ORLEN_PACZKA_SANDBOX=true
ORLEN_PACZKA_SENDER_EMAIL=
ORLEN_PACZKA_SENDER_PHONE=
ORLEN_PACZKA_SENDER_NAME=
ORLEN_PACZKA_SENDER_COMPANY=
ORLEN_PACZKA_SENDER_STREET=
ORLEN_PACZKA_SENDER_BUILDING=
ORLEN_PACZKA_SENDER_CITY=
ORLEN_PACZKA_SENDER_POSTCODE=

# Accounting: Fakturownia.pl
ACCOUNTING_FAKTUROWNIA_ENABLED=false
ACCOUNTING_FAKTUROWNIA_API_TOKEN=
ACCOUNTING_FAKTUROWNIA_DOMAIN=

# Accounting: iFirma.pl
ACCOUNTING_IFIRMA_ENABLED=false
ACCOUNTING_IFIRMA_API_KEY=
ACCOUNTING_IFIRMA_USERNAME=

# Accounting: inFakt.pl
ACCOUNTING_INFAKT_ENABLED=false
ACCOUNTING_INFAKT_API_KEY=

# Accounting: wFirma.pl
ACCOUNTING_WFIRMA_ENABLED=false
ACCOUNTING_WFIRMA_API_KEY=
ACCOUNTING_WFIRMA_ACCESS_KEY=

VITE_APP_NAME="${APP_NAME}"

