---
// BlikWidget.astro
// Example usage: <BlikWidget orderNumber={order.number} email={order.customer_email} />
interface Props {
  orderNumber: string;
  email: string;
}

const { orderNumber, email } = Astro.props;
---

<div class="blik-payment-container max-w-md mx-auto p-6 bg-white border border-gray-100 rounded-2xl shadow-sm text-center">
  <div class="flex items-center justify-center gap-2 mb-4">
    <!-- BLIK logo styled with CSS -->
    <span class="px-3 py-1 font-bold text-white bg-pink-600 rounded-lg tracking-wider text-xl uppercase italic">blik</span>
    <h3 class="text-lg font-semibold text-gray-800">Szybka płatność BLIK</h3>
  </div>

  <p class="text-sm text-gray-500 mb-6">Wpisz 6-cyfrowy kod z aplikacji swojego banku i zatwierdź płatność na telefonie.</p>

  <form id="blik-form" class="space-y-4" data-number={orderNumber} data-email={email}>
    <div class="relative">
      <input
        type="text"
        id="blik-code-input"
        name="blik_code"
        pattern="[0-9]{6}"
        maxlength="6"
        placeholder="000 000"
        autocomplete="one-time-code"
        inputmode="numeric"
        required
        class="w-full text-center tracking-[1em] text-2xl font-bold py-3 border border-gray-200 rounded-xl focus:border-pink-500 focus:ring-2 focus:ring-pink-100 transition duration-200"
      />
    </div>

    <button
      type="submit"
      id="blik-submit-btn"
      class="w-full bg-pink-600 hover:bg-pink-700 text-white font-medium py-3 rounded-xl transition duration-200 shadow-md shadow-pink-100"
    >
      Kupuję i płacę
    </button>
  </form>

  <div id="blik-status" class="hidden mt-4 text-sm font-medium text-pink-600 animate-pulse">
    Oczekiwanie na potwierdzenie transakcji w Twojej aplikacji bankowej...
  </div>
</div>

<script>
  const form = document.getElementById('blik-form');
  const input = document.getElementById('blik-code-input') as HTMLInputElement;
  const statusDiv = document.getElementById('blik-status');
  const submitBtn = document.getElementById('blik-submit-btn') as HTMLButtonElement;

  // Formatting spacing while typing
  input?.addEventListener('input', (e) => {
    let val = input.value.replace(/\D/g, '');
    input.value = val.slice(0, 6);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const orderNumber = form.getAttribute('data-number');
    const email = form.getAttribute('data-email');
    const blikCode = input.value;

    if (blikCode.length !== 6) {
      alert('Kod BLIK musi składać się z 6 cyfr!');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerText = 'Przetwarzanie...';
    statusDiv?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/checkout/orders/${orderNumber}/payment-session`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Order-Email': email || '',
        },
        body: JSON.stringify({ blik_code: blikCode }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Wystąpił błąd podczas autoryzacji BLIK.');
      }

      const session = result.data.payment_session;

      if (session.next_action === 'await_blik_confirmation') {
        // Direct BLIK transaction initiated! Start polling order payment status
        pollOrderStatus(orderNumber, email);
      } else if (session.redirect_url) {
        // Fallback if redirect is needed
        window.location.href = session.redirect_url;
      }
    } catch (err: any) {
      alert(err.message);
      submitBtn.disabled = false;
      submitBtn.innerText = 'Kupuję i płacę';
      statusDiv?.classList.add('hidden');
    }
  });

  async function pollOrderStatus(number: string | null, email: string | null) {
    let attempts = 0;
    const maxAttempts = 30; // 60 seconds total

    const interval = setInterval(async () => {
      attempts++;
      if (attempts > maxAttempts) {
        clearInterval(interval);
        alert('Przekroczono limit czasu oczekiwania na akceptację płatności. Spróbuj ponownie.');
        location.reload();
        return;
      }

      try {
        const response = await fetch(`/api/checkout/orders/${number}?email=${encodeURIComponent(email || '')}`);
        const result = await response.json();
        
        if (result.data && result.data.order.payment_status === 'paid') {
          clearInterval(interval);
          // Payment confirmed! Redirect to success page
          window.location.href = `/checkout/sukces?number=${number}`;
        } else if (result.data && result.data.order.payment_status === 'failed') {
          clearInterval(interval);
          alert('Płatność została odrzucona w aplikacji bankowej.');
          location.reload();
        }
      } catch (err) {
        console.error('Error polling order status:', err);
      }
    }, 2000);
  }
</script>
